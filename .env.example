# ── Cloudflare Edge Worker (Facebook, Live Viewers, & GitHub Proxy) ───────────
# URL of your deployed Cloudflare Worker (e.g., https://facebook-proxy.your-subdomain.workers.dev)
# Handles edge caching (30m TTL) and server-side token authentication so secrets
# are never exposed to browser bundles, eliminating the 60 req/hr rate limit.
VITE_FB_WORKER_URL=https://facebook-proxy.YOUR_SUBDOMAIN.workers.dev

# Dedicated GitHub Worker URL (optional if using unified worker above)
# VITE_GITHUB_WORKER_URL=https://github-proxy.YOUR_SUBDOMAIN.workers.dev

# ── GitHub Configuration ──────────────────────────────────────────────────────
# Defaults to joshuapalero if unset
VITE_GITHUB_USERNAME=joshuapalero

# Local Development Only:
# In production, DO NOT bundle personal access tokens in client builds.
# Instead, store the token securely in Cloudflare: `npx wrangler secret put GITHUB_TOKEN`.
# For local development without a worker, you may optionally set a read-only Fine-Grained PAT here:
VITE_GITHUB_TOKEN=

# ── GitHub Gist (Live Experience) ─────────────────────────────────────────────
# Optional: ID of your public GitHub Gist containing experience.json
# If left blank, the portfolio automatically auto-discovers experience.json from your public gists
VITE_GITHUB_GIST_ID=

# ── Contact & Collaboration Configurations ("Let's Work Together") ───────────
# Primary contact email (defaults to joshuapalero111@gmail.com if omitted)
VITE_CONTACT_EMAIL=joshuapalero111@gmail.com

# Schedule a Call URL: Calendly, Cal.com, or Google Calendar appointment scheduling link
# Example: https://calendly.com/joshuapalero111 or https://cal.com/your-username/30min
VITE_SCHEDULE_CALL_URL=https://calendly.com/joshuapalero111

# Optional default email subject and body template (RFC 6068 compliant)
VITE_CONTACT_SUBJECT=Project Inquiry / Collaboration - Joshua Palero

# ── Resume ────────────────────────────────────────────────────────────────────
# Path to the resume PDF in /public (defaults to "/Joshua Pasacay Palero Resume.pdf")
# VITE_RESUME_URL=/Joshua Pasacay Palero Resume.pdf

# ── Social Profile URLs (Navigation) ─────────────────────────────────────────
# Set these to your actual profile URLs to fix the navigation links.
# If omitted, the defaults in social_data.tsx are used.
VITE_LINKEDIN_URL=https://linkedin.com/in/joshuapalero
VITE_FACEBOOK_URL=https://facebook.com/joshuapalero
VITE_INSTAGRAM_URL=https://instagram.com/joshuapalero
